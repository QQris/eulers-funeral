  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>BIENVENIDO A EULER'S FUNERAL</b>\n\n<b>Objetivo General:</b>\nGu\xEDa
    la pelota blanca desde el marcador de inicio (A) para recolectar las <b>3 estrellas
    rojas</b> distribuidas en el espacio 3D (ejes X, Y y altura Z).\n\n<b>Controles:</b>\n\u2022
    <b>Clic derecho sostenido:</b> Orbitar la c\xE1mara 3D (sin bajar del plano).\n\u2022
    <b>Rueda del rat\xF3n:</b> Zoom (acercar / alejar).\n\u2022 <b>Teclado:</b> Escribe
    la ecuaci\xF3n de dos variables <i>f(x, y)</i> en espa\xF1ol; la malla de 100\xD7100
    puntos se genera autom\xE1ticamente al ser v\xE1lida (admite multiplicaci\xF3n
    impl\xEDcita como <i>-0.2x - 0.2y</i>, <i>0.2y^2 - 0.25x</i>, <i>sen(x)</i>,
    <i>floor(x)</i>, <i>ceil(x)</i>, <i>e^x</i>).\n\u2022 <b>Lanzar:</b> Inicia la
    simulaci\xF3n f\xEDsica Lagrangiana (RK4)."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
